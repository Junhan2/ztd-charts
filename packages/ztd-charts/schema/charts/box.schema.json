{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/ztd-charts/schema/charts/box.schema.json",
  "title": "Box / violin plot",
  "description": "Distribution summary by group (quartiles, median, outliers). Use when: Distribution and outliers together, such as response time by API. Avoid when: The audience is not used to quartiles (a beeswarm is easier)",
  "type": "object",
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "box"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "encoding": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "Group field (string)"
        },
        "value": {
          "type": "string",
          "description": "Value field (number)"
        }
      },
      "required": [
        "group",
        "value"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "variant": {
          "description": "Shape",
          "default": "box",
          "enum": [
            "box",
            "violin",
            "both"
          ]
        },
        "outliers": {
          "description": "Show outlier dots",
          "default": true,
          "type": "boolean"
        },
        "zero": {
          "description": "Include 0 on the axis",
          "default": false,
          "type": "boolean"
        },
        "whiskers": {
          "description": "Whisker ends as percentiles [low, high], such as [5, 95]. Without it, whiskers reach the farthest values within 1.5 × IQR",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "height": {
          "description": "Height in px. Without it, each chart picks a default that fits its width",
          "type": "number",
          "minimum": 40
        },
        "width": {
          "description": "Fixed width in px. Without it, the chart fits its parent",
          "type": "number",
          "minimum": 40
        },
        "highlight": {
          "description": "Item to highlight. An index, a name, an array, or \"max\" | \"min\" | \"first\" | \"last\" | \"none\"",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          ]
        },
        "format": {
          "description": "Value format. \"number\" | \"integer\" | \"percent\" | \"ratio\" | \"compact\" | \"currency\" | \"decimal\" or Intl.NumberFormat options",
          "anyOf": [
            {
              "enum": [
                "number",
                "integer",
                "percent",
                "ratio",
                "compact",
                "currency",
                "decimal"
              ]
            },
            {
              "type": "object",
              "description": "Intl.NumberFormat options plus suffix and prefix"
            }
          ]
        },
        "unit": {
          "description": "Unit appended to values. For example \"%\" or \"ms\"",
          "type": "string"
        },
        "locale": {
          "description": "Locale for numbers, dates and the text a chart writes itself (tooltips, screen reader sentences). \"ko\" or \"ko-*\" switches to Korean. Falls back to the ThemeProvider locale",
          "default": "en-US",
          "type": "string"
        },
        "animate": {
          "description": "Entry and update animation",
          "default": true,
          "type": "boolean"
        },
        "duration": {
          "description": "Animation length (ms)",
          "type": "number",
          "minimum": 0
        },
        "easing": {
          "description": "Motion curve",
          "default": "spring",
          "enum": [
            "spring",
            "easeOut",
            "easeInOut",
            "linear"
          ]
        },
        "stagger": {
          "description": "Delay between items as they enter (ms)",
          "type": "number",
          "minimum": 0
        },
        "reducedMotion": {
          "description": "\"auto\" follows the OS setting. true always turns motion off",
          "default": "auto"
        },
        "animateOnView": {
          "description": "Play when the chart scrolls into view",
          "default": true,
          "type": "boolean"
        },
        "showLabels": {
          "description": "Labels drawn on the chart (values and names)",
          "default": true,
          "type": "boolean"
        },
        "tooltip": {
          "description": "Show tooltips",
          "default": true,
          "type": "boolean"
        },
        "ariaLabel": {
          "description": "Name for screen readers",
          "type": "string"
        },
        "description": {
          "description": "Description for screen readers. Built from the data when omitted",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "data": {
      "description": "An array of objects, or one of { values }, { csv }, { url }",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "csv"
          ],
          "properties": {
            "csv": {
              "type": "string",
              "description": "CSV text (the first line is the header)"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "JSON or CSV address (REST API, Google Sheets CSV export and so on)"
            },
            "format": {
              "enum": [
                "json",
                "csv",
                "auto"
              ],
              "default": "auto"
            },
            "select": {
              "type": "string",
              "description": "Path to the array inside the response JSON. For example \"data.items\""
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "card": {
      "type": "object",
      "description": "Wraps the chart in a card with a number, title, legend, one-line takeaway and level badge",
      "properties": {
        "number": {
          "type": "string",
          "description": "For example \"01\""
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "takeaway": {
          "type": "string",
          "description": "Bold one-line takeaway at the bottom"
        },
        "level": {
          "type": "string",
          "description": "\"basic\" | \"intermediate\" | \"advanced\". The Korean \"기본\" | \"중급\" | \"심화\" also work"
        },
        "legend": {
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "shape": {
                    "enum": [
                      "square",
                      "line",
                      "dash",
                      "circle"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "description": "Marks the data as sample data"
        },
        "replay": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "anyOf": [
        {
          "enum": [
            "dark",
            "light"
          ]
        },
        {
          "type": "object",
          "description": "Token overrides. For example { accent: \"#00C2FF\" }",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ]
    }
  }
}
