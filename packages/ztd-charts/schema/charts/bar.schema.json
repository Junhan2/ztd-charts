{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/ztd-charts/schema/charts/bar.schema.json",
  "title": "Bar chart",
  "description": "Grouped, stacked, 100% and horizontal bars. Use when: Comparing sizes across categories precisely. Avoid when: The flow over time is the point (a line works better)",
  "type": "object",
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "bar"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "encoding": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string",
          "description": "Category field (string)"
        },
        "y": {
          "description": "Value field. An array for wide tables (number)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "series": {
          "type": "string",
          "description": "Series field (string)"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "layout": {
          "description": "How series are arranged",
          "default": "grouped",
          "enum": [
            "grouped",
            "stacked",
            "percent"
          ]
        },
        "orientation": {
          "description": "Direction",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "sort": {
          "description": "Sort by value (single series)",
          "default": false,
          "type": "boolean"
        },
        "annotations": {
          "description": "Notes drawn on vertical bars: target band, period, reference line, event, forecast (later bars turn pale with a dashed outline), trend line. [{ type, x, y, from, label }]",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "band",
                  "line",
                  "event",
                  "forecast",
                  "trend",
                  "weekends"
                ],
                "description": "\"band\" shaded range | \"line\" reference line | \"event\" marker | \"forecast\" dashed from here on | \"trend\" least-squares line | \"weekends\" shading (date x)"
              },
              "x": {
                "description": "event: the x value. band: [from, to] on x"
              },
              "y": {
                "description": "line: the y value. band: [low, high] on y",
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              },
              "from": {
                "description": "forecast: the x value where the forecast starts"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "height": {
          "description": "Height in px. Without it, each chart picks a default that fits its width",
          "type": "number",
          "minimum": 40
        },
        "width": {
          "description": "Fixed width in px. Without it, the chart fits its parent",
          "type": "number",
          "minimum": 40
        },
        "highlight": {
          "description": "Item to highlight. An index, a name, an array, or \"max\" | \"min\" | \"first\" | \"last\" | \"none\"",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          ]
        },
        "format": {
          "description": "Value format. \"number\" | \"integer\" | \"percent\" | \"ratio\" | \"compact\" | \"currency\" | \"decimal\" or Intl.NumberFormat options",
          "anyOf": [
            {
              "enum": [
                "number",
                "integer",
                "percent",
                "ratio",
                "compact",
                "currency",
                "decimal"
              ]
            },
            {
              "type": "object",
              "description": "Intl.NumberFormat options plus suffix and prefix"
            }
          ]
        },
        "unit": {
          "description": "Unit appended to values. For example \"%\" or \"ms\"",
          "type": "string"
        },
        "locale": {
          "description": "Locale for numbers, dates and the text a chart writes itself (tooltips, screen reader sentences). \"ko\" or \"ko-*\" switches to Korean. Falls back to the ThemeProvider locale",
          "default": "en-US",
          "type": "string"
        },
        "animate": {
          "description": "Entry and update animation",
          "default": true,
          "type": "boolean"
        },
        "duration": {
          "description": "Animation length (ms)",
          "type": "number",
          "minimum": 0
        },
        "easing": {
          "description": "Motion curve",
          "default": "spring",
          "enum": [
            "spring",
            "easeOut",
            "easeInOut",
            "linear"
          ]
        },
        "stagger": {
          "description": "Delay between items as they enter (ms)",
          "type": "number",
          "minimum": 0
        },
        "reducedMotion": {
          "description": "\"auto\" follows the OS setting. true always turns motion off",
          "default": "auto"
        },
        "animateOnView": {
          "description": "Play when the chart scrolls into view",
          "default": true,
          "type": "boolean"
        },
        "showLabels": {
          "description": "Labels drawn on the chart (values and names)",
          "default": true,
          "type": "boolean"
        },
        "tooltip": {
          "description": "Show tooltips",
          "default": true,
          "type": "boolean"
        },
        "syncId": {
          "description": "Charts with the same syncId show the hovered x together (line, area, bar, candlestick). <ChartGrid sync> sets one for every chart inside it",
          "type": "string"
        },
        "ariaLabel": {
          "description": "Name for screen readers",
          "type": "string"
        },
        "description": {
          "description": "Description for screen readers. Built from the data when omitted",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "data": {
      "description": "An array of objects, or one of { values }, { csv }, { url }",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "csv"
          ],
          "properties": {
            "csv": {
              "type": "string",
              "description": "CSV text (the first line is the header)"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "JSON or CSV address (REST API, Google Sheets CSV export and so on)"
            },
            "format": {
              "enum": [
                "json",
                "csv",
                "auto"
              ],
              "default": "auto"
            },
            "select": {
              "type": "string",
              "description": "Path to the array inside the response JSON. For example \"data.items\""
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "card": {
      "type": "object",
      "description": "Wraps the chart in a card with a number, title, legend, one-line takeaway and level badge",
      "properties": {
        "number": {
          "type": "string",
          "description": "For example \"01\""
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "takeaway": {
          "type": "string",
          "description": "Bold one-line takeaway at the bottom"
        },
        "level": {
          "type": "string",
          "description": "\"basic\" | \"intermediate\" | \"advanced\". The Korean \"기본\" | \"중급\" | \"심화\" also work"
        },
        "legend": {
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "shape": {
                    "enum": [
                      "square",
                      "line",
                      "dash",
                      "circle"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "description": "Marks the data as sample data"
        },
        "replay": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "anyOf": [
        {
          "enum": [
            "dark",
            "light"
          ]
        },
        {
          "type": "object",
          "description": "Token overrides. For example { accent: \"#00C2FF\" }",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ]
    }
  }
}
