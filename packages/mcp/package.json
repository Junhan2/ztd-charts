{
  "name": "ztd-charts-mcp",
  "version": "0.3.0",
  "description": "ztd-charts MCP server (stdio): list charts, get schemas, validate specs, render SVG/PNG, and get chart suggestions from data",
  "license": "MIT",
  "author": "Junhan2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Junhan2/ztd-charts.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://charts.ztd.app/docs/docs/mcp/",
  "type": "module",
  "bin": {
    "ztd-charts-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": { "types": "./dist/server.d.ts", "default": "./dist/server.js" }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ztd-charts": "workspace:*",
    "ztd-charts-cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "5.9.3"
  }
}
